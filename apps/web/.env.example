# ═══════════════════════════════════════════════════════
#  Web Frontend — Variables d'environnement Vite
#  Copier ce fichier en .env et remplir les valeurs
#  Note : toutes les variables VITE_ sont publiques (dans le bundle)
# ═══════════════════════════════════════════════════════

# L'API est proxifiée par Vite en dev — pas besoin d'URL absolue
# En production, définir l'URL complète
VITE_API_URL=/api/v1
VITE_APP_NAME=MatériauxPro
