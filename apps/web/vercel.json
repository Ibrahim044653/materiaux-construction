{
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @boutikpro/shared build && pnpm --filter @boutikpro/web build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|sw.js|manifest.webmanifest|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
