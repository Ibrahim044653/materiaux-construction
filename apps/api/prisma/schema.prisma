// ╔══════════════════════════════════════════════════════════╗
// ║  Prisma Schema — SaaS Matériaux de Construction          ║
// ║  Toutes les tables métier ont un tenantId obligatoire    ║
// ║  Tous les montants en Decimal(12,2) — jamais Float       ║
// ╚══════════════════════════════════════════════════════════╝

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
}

enum TenantPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProductCategory {
  CIMENT
  FER_BETON
  TOLE
  PEINTURE
  CARRELAGE
  PLOMBERIE
  ELECTRICITE
  BOIS
  AUTRE
}

enum PaymentMethod {
  CASH
  ORANGE_MONEY
  WAVE
  MTN_MONEY
  VIREMENT
  CREDIT
}

enum SaleStatus {
  COMPLETED
  PENDING_CREDIT
  CANCELLED
  RETURNED
}

enum StockMovementType {
  IN
  OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
//  MULTI-TENANT
// ─────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  phone     String?
  plan      TenantPlan   @default(STARTER)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users          User[]
  stores         Store[]
  products       Product[]
  customers      Customer[]
  suppliers      Supplier[]
  sales          Sale[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────
//  UTILISATEURS
// ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  storeId      String?
  email        String    @unique
  name         String
  phone        String?
  avatar       String?
  passwordHash String
  role         Role      @default(CASHIER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  store         Store?         @relation(fields: [storeId], references: [id])
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  sales         Sale[]         @relation("SaleCashier")
  stockMovements StockMovement[]

  @@index([tenantId, role])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─────────────────────────────────────────────────────────────
//  MAGASINS
// ─────────────────────────────────────────────────────────────

model Store {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  users          User[]
  stockEntries   StockEntry[]
  stockMovements StockMovement[]
  sales          Sale[]
  purchaseOrders PurchaseOrder[]
  transfersFrom  StoreTransfer[] @relation("TransferFrom")
  transfersTo    StoreTransfer[] @relation("TransferTo")

  @@index([tenantId])
  @@map("stores")
}

// ─────────────────────────────────────────────────────────────
//  PRODUITS & STOCKS
// ─────────────────────────────────────────────────────────────

model Product {
  id          String          @id @default(cuid())
  tenantId    String
  reference   String
  name        String
  category    ProductCategory
  description String?
  photo       String?
  barcode     String?
  qrCode      String?
  buyPrice    Decimal         @db.Decimal(12, 2)
  sellPrice   Decimal         @db.Decimal(12, 2)
  tva         Decimal         @default(18) @db.Decimal(5, 2)
  unit        String          @default("unité")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stockEntries   StockEntry[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseOrderItem[]
  transferItems  StoreTransferItem[]

  @@unique([tenantId, reference])
  @@index([tenantId, category])
  @@index([barcode])
  @@map("products")
}

model StockEntry {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  storeId        String
  quantity       Decimal  @default(0) @db.Decimal(12, 2)
  alertThreshold Decimal  @default(5) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@index([tenantId, storeId])
  @@map("stock_entries")
}

model StockMovement {
  id          String            @id @default(cuid())
  tenantId    String
  productId   String
  storeId     String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2)
  reason      String?
  referenceId String?           // ID de la vente, BC, transfert
  createdById String
  createdAt   DateTime          @default(now())

  product     Product @relation(fields: [productId], references: [id])
  store       Store   @relation(fields: [storeId], references: [id])
  createdBy   User    @relation(fields: [createdById], references: [id])

  @@index([tenantId, storeId, createdAt])
  @@index([productId])
  @@map("stock_movements")
}

model StoreTransfer {
  id          String   @id @default(cuid())
  tenantId    String
  fromStoreId String
  toStoreId   String
  status      String   @default("PENDING")  // PENDING, VALIDATED, CANCELLED
  notes       String?
  createdById String
  validatedAt DateTime?
  createdAt   DateTime @default(now())

  fromStore Store               @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore   Store               @relation("TransferTo", fields: [toStoreId], references: [id])
  items     StoreTransferItem[]

  @@index([tenantId])
  @@map("store_transfers")
}

model StoreTransferItem {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(12, 2)

  transfer StoreTransfer @relation(fields: [transferId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])

  @@map("store_transfer_items")
}

// ─────────────────────────────────────────────────────────────
//  VENTES (CAISSE)
// ─────────────────────────────────────────────────────────────

model Sale {
  id             String        @id @default(cuid())
  tenantId       String
  storeId        String
  cashierId      String
  customerId     String?
  receiptNumber  String
  status         SaleStatus    @default(COMPLETED)
  paymentMethod  PaymentMethod
  subtotal       Decimal       @db.Decimal(12, 2)
  globalDiscount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @db.Decimal(12, 2)
  amountDue      Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  store    Store     @relation(fields: [storeId], references: [id])
  cashier  User      @relation("SaleCashier", fields: [cashierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  items    SaleItem[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, storeId, createdAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String  // Dénormalisé pour l'historique
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

// ─────────────────────────────────────────────────────────────
//  CLIENTS & CRÉANCES
// ─────────────────────────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  phone         String?
  email         String?
  address       String?
  creditBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  sales    Sale[]
  payments CustomerPayment[]

  @@index([tenantId])
  @@index([phone])
  @@map("customers")
}

model CustomerPayment {
  id            String   @id @default(cuid())
  tenantId      String
  customerId    String
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String
  notes         String?
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_payments")
}

// ─────────────────────────────────────────────────────────────
//  FOURNISSEURS & APPROVISIONNEMENTS
// ─────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  phone       String?
  email       String?
  address     String?
  contactName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  tenantId    String
  storeId     String
  supplierId  String
  orderNumber String
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Decimal             @db.Decimal(12, 2)
  notes       String?
  expectedAt  DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  store    Store               @relation(fields: [storeId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, storeId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  productName      String
  quantityOrdered  Decimal @db.Decimal(12, 2)
  quantityReceived Decimal @default(0) @db.Decimal(12, 2)
  unitPrice        Decimal @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)

  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("purchase_order_items")
}
