# ═══════════════════════════════════════════════════════
#  API — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════

# ── Serveur ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── Base de données ───────────────────────────────────
DATABASE_URL="postgresql://materiaux:materiaux_dev_pwd@localhost:5432/materiaux_db?schema=public"

# ── JWT ───────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_64_CHARS_MINIMUM

# ── CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── Email (Nodemailer) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-app
EMAIL_FROM="MatériauxPro <noreply@materiaux.pro>"

# ── Stockage fichiers ─────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ── Super Admin (créé au premier démarrage) ───────────
SUPER_ADMIN_EMAIL=admin@materiaux.pro
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD
SUPER_ADMIN_NAME=Super Administrateur
